# Graphite Web Basic mod_wsgi vhost

WSGIPythonPath {{ graphite_root_dir }}
{%  if ansible_distribution | lower == "centos" and ansible_distribution_major_version == "6" %}
WSGISocketPrefix run/wsgi
{% endif %}

<VirtualHost *:80>
    Header set Access-Control-Allow-Origin    "http://127.0.0.1:3000"
    Header set Access-Control-Allow-Methods   "GET, OPTIONS"
    Header set Access-Control-Allow-Headers   "origin, authorization, accept"
    Header set Access-Control-Allow-Credentials true

    ServerName graphite
    DocumentRoot {{ graphite_root_dir }}/webapp
    ErrorLog {{ graphite_log_dir }}/graphite-web-error.log
    CustomLog {{ graphite_log_dir }}/graphite-web-access.log common

    WSGIDaemonProcess graphite processes=5 threads=5 display-name='%{GROUP}' inactivity-timeout=120
    WSGIProcessGroup graphite
    WSGIApplicationGroup %{GLOBAL}
    WSGIScriptAlias / {{ graphite_root_dir }}/graphite-web.wsgi
    WSGIImportScript {{ graphite_root_dir }}/graphite-web.wsgi process-group=graphite application-group=%{GLOBAL}

    <Directory {{  graphite_root_dir }}>
        <Files * >
            AllowOverride None
            {%  if ansible_distribution | lower == "centos" and ansible_distribution_major_version == "7" %}
            Require all granted
            {% endif %}
        </Files>
    </Directory>

    Alias /content/ {{  graphite_root_dir }}/webapp/content/
    <Location "/content/">
        SetHandler None
    </Location>

    Alias /media/ "{{ python_version }}/site-packages/django/contrib/admin/"
    <Location "/media/">
        SetHandler None
    </Location>

</VirtualHost>